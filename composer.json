{
  "name": "esoul/laravel-ott-jwt",
  "description": "OTT JWT package for Laravel",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Tomáš Vojík",
      "email": "vojik@esoul.cz"
    }
  ],
  "require": {
    "php": ">=8.5",
    "illuminate/support": "^10.2|^11.0|^12.0",
    "spatie/laravel-package-tools": "^1.16.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^12",
    "laravel/pail": "^1.2.2",
    "laravel/framework": "^12.48",
    "esoul-cz/coding-standard": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Esoul\\OttJwt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Esoul\\OttJwt\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage",
    "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Esoul\\OttJwt\\JwtServiceProvider"
      ],
      "aliases": {
        "JwtParser": "Esoul\\OttJwt\\Facades\\JwtParser"
      }
    }
  }
}
